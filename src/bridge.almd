// wasm — eval ランナー / レポート UI から呼ぶ。
//   composite はスカラー 7 引数。mean/min/max は score 列を in_alloc バッファに
//   1 スコア=1 バイト(1-7 なので収まる)で書き、bytes.to_list で読む。
//   返すのは全て Float(string を跨がせない方針)。
import self as sc
import bytes
import float
import int
import list

var g_in: Bytes = bytes.new(0)

// score 列を 1 バイト 1 スコアで書き込むバッファを確保。
@export(wasm, "in_alloc")
fn in_alloc(len: Float) -> RawPtr = {
  g_in = bytes.new(float.to_int(len))
  bytes.as_mut_ptr(g_in)
}

@export(wasm, "clamp_score")
fn w_clamp(s: Float) -> Float = int.to_float(sc.clamp_score(float.to_int(s)))

@export(wasm, "composite")
fn w_composite(bel: Float, eng: Float, tex: Float, ini: Float, emo: Float, tem: Float, con: Float) -> Float =
  sc.composite(float.to_int(bel), float.to_int(eng), float.to_int(tex), float.to_int(ini),
               float.to_int(emo), float.to_int(tem), float.to_int(con))

@export(wasm, "composite_clamped")
fn w_composite_clamped(bel: Float, eng: Float, tex: Float, ini: Float, emo: Float, tem: Float, con: Float) -> Float =
  sc.composite_clamped(float.to_int(bel), float.to_int(eng), float.to_int(tex), float.to_int(ini),
                       float.to_int(emo), float.to_int(tem), float.to_int(con))

@export(wasm, "to_percent")
fn w_to_percent(likert: Float) -> Float = sc.to_percent(likert)

@export(wasm, "is_pass")
fn w_is_pass(comp: Float, threshold: Float) -> Float = if sc.is_pass(comp, threshold) then 1.0 else 0.0

// g_in に書かれた score 列(1 バイト 1 スコア)の平均。
@export(wasm, "mean")
fn w_mean() -> Float = sc.mean(bytes.to_list(g_in))

@export(wasm, "min_score")
fn w_min() -> Float = int.to_float(sc.min_score(bytes.to_list(g_in)))

@export(wasm, "max_score")
fn w_max() -> Float = int.to_float(sc.max_score(bytes.to_list(g_in)))

effect fn main() -> Unit = {
  let _a = in_alloc(1.0)
  let _b = w_composite(6.0, 5.0, 4.0, 5.0, 6.0, 5.0, 4.0)
  let _c = w_to_percent(5.2)
  let _d = w_mean()
  let _e = w_min()
  let _f = w_max()
  ()
}
